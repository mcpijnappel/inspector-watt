# Copy to .env to override defaults from compose.yaml. The voltage limit, idle power-off, measuring on connect,
# raw precision, free disk and the UART speed are settings in the web UI (Settings), not here.
# PPK2_PORT=/host-dev/ppk2        # or sim:// for the simulator
# UART_PORT=/host-dev/dut-uart    # or sim://
# RING_SECONDS=300                # live RAM buffer, ~0.5 MB per second
# LOG_LEVEL=INFO
# DB_PASSWORD=tracker
# DATA_DIR=./data                 # raw Parquet files
# API_PORT=8000  CAPTURE_PORT=8100  DB_PORT=5432
# WEB_PORT=8080  WEB_BIND=127.0.0.1   # web UI; 0.0.0.0 = the whole network (no login: trusted networks only)
# MCP_PORT=8300                  # MCP for agents on this machine: http://localhost:8300/mcp
# MCP_TOKEN=                      # first start only: LAN access for agents with this token (then: Settings → Agents)
# FLASH_TOKEN=                    # first start only: upload token for PlatformIO (default: a random one; see /api/flash/settings)
# IMAGE_TAG=latest                # published image version for ./dc pull (e.g. 1.2)
# UID=1000  GID=1000              # your user and group id (id -u, id -g), if not 1000
